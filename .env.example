# Copy this file to .env and adjust for your environment.

# --- Django core ---
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Falls back to a local sqlite file when DATABASE_URL is empty.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/community_db

# --- Site branding ---
SITE_NAME=CityForge
SITE_TAGLINE=Your community, forged together.

# --- OpenSearch (for resource search) ---
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=False
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_NAMESPACE=default

# --- Email (password reset, verification) ---
# Use the console backend in dev to print emails to stdout.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# --- Uploads ---
MEDIA_ROOT=uploads

# --- Optional bootstrap superuser (entrypoint creates if both set) ---
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
