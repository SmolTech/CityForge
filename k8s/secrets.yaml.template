# IMPORTANT: Before applying this file:
# 1. Generate secure Django secret: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 2. Base64 encode: echo -n "your_secret_here" | base64
# 3. Replace the placeholders below with your base64-encoded secrets
# 4. Store the original secrets securely for backup

apiVersion: v1
kind: Secret
metadata:
  name: cityforge-secrets
  namespace: cityforge
  labels:
    app: cityforge
type: Opaque
data:
  # Replace with base64-encoded Django secret key
  # Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
  # Then encode: echo -n "your_django_secret" | base64
  DJANGO_SECRET_KEY: ZGphbmdvLWluc2VjdXJlLWRldi1vbmx5LWNoYW5nZS1tZQ==  # django-insecure-dev-only-change-me

---
